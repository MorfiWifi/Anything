<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Thin build wrapper. Code is split across Core/ (primitives), Engine/
    (orchestration), Service/ (SCM host + control pipe), Ipc/ (protocol),
    Cli/ (client) and Program.cs (bootstrap); one assembly / one executable.
    - dotnet run                       (from an elevated Windows terminal)
    - dotnet publish -c Release -r win-x64 [self-contained single file, see README]
    EnableWindowsTargeting lets this Windows-targeted project also compile
    on non-Windows machines for syntax checking (it will refuse sharing at runtime).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Anything</AssemblyName>
    <RootNamespace>Anything</RootNamespace>
    <!-- Base version for autoversioning. Local builds use this as-is (1.3.0).
         CI appends the GitHub run number on the `release` branch:
           dotnet publish /p:Version=$(VersionPrefix).<run_number>
         so every release build gets a unique version (e.g. 1.3.0.78) and the
         GitHub Release is tagged v<that version>. Bump VersionPrefix here to
         start a new series. No NuGet versioning packages required. -->
    <VersionPrefix>1.3.0</VersionPrefix>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <Description>Anything — share any folder by IP address as a background Windows service, with optional dedicated-subnet NAT/DHCP for a cabled client.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <InternalsVisibleTo Include="Anything.Tests" />
  </ItemGroup>

</Project>
